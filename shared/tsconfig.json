{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",           // Back to CommonJS
    "moduleResolution": "Node",     // Back to Node
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules"]
}