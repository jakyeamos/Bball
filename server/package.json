{
  "name": "nba-draft-sim-server",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "seed:nba": "tsx scripts/seedBallDontLie.ts",
    "seed:nba:offline": "tsx scripts/seedBallDontLie.ts --offline",
    "refresh:nba-cache": "tsx scripts/refreshBallDontLieCache.ts",
    "test": "vitest run",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nba-draft-sim/shared": "file:../shared",
    "@supabase/supabase-js": "^2.100.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.27",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/runner": "^4.0.18",
    "eslint": "^8.57.1",
    "tsx": "4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
