{
  "version": 1,
  "coveragePaths": [
    "coverage/lcov.info",
    "coverage/coverage-final.json",
    ".nyc_output/coverage.json",
    "coverage.lcov",
    "lcov.info",
    "coverage.out"
  ],
  "coverageFormat": "auto",
  "threshold": 80,
  "excludePatterns": [
    ".quality-gate-exceptions",
    "vercel.json",
    "tests/guest-entry/playwright.config.ts",
    "tests/guest-entry/guest-entry.spec.ts",
    ".tracker/PROJECT_TRUTH.md",
    "knip.json",
    "README.md",
    ".project-compass/development.json",
    ".project-compass/behaviors.json",
    ".pre-cr.json",
    "package.json"
  ],
  "checks": {
    "coverage": true,
    "security": true,
    "checklist": true
  },
  "testCommand": "pnpm test:guest-coverage"
}
