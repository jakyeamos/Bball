{
  "version": 1,
  "coveragePaths": [
    "coverage/lcov.info",
    "coverage/coverage-final.json",
    ".nyc_output/coverage.json",
    "coverage.lcov",
    "lcov.info",
    "coverage.out"
  ],
  "coverageFormat": "auto",
  "threshold": 80,
  "excludePatterns": [
    ".quality-gate-exceptions",
    "vercel.json"
  ],
  "checks": {
    "coverage": true,
    "security": true,
    "checklist": true
  },
  "testCommand": "pnpm test:coverage"
}
