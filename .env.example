# Server configuration
PORT=3001
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Supabase — SERVER only (service-role key must never reach the client)
# Get these from: Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase — CLIENT (public anon key; safe to expose in browser bundles)
# Vite requires VITE_ prefix for browser-accessible variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# BallDontLie — SERVER only (`npm run seed:nba --workspace=server`). Not used on the HTTP request path.
# Get a key from https://www.balldontlie.io (NBA API). Optional for local dev if you only use `seed:nba:offline`.
BALLDONTLIE_API_KEY=your-balldontlie-api-key-here
